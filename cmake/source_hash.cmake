# Writes a header defining NAME as a 64-bit hash of the contents of SOURCES (a ;-separated list).
# Run as a build step that depends on the sources, so the value changes with any edit to them:
#   cmake -DNAME=... -DOUT=<header> -DSOURCES=<files> -P source_hash.cmake
set(all "")
foreach(source IN LISTS SOURCES)
    file(SHA256 "${source}" digest)
    string(APPEND all "${digest}")
endforeach()
string(SHA256 digest "${all}")
string(SUBSTRING "${digest}" 0 16 value)
set(text "// Generated by cmake/source_hash.cmake. Do not edit.\n#pragma once\n#define ${NAME} 0x${value}ull\n")
# Rewritten only when the value changes, so that touching a source alone recompiles nothing.
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
